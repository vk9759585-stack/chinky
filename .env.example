# Copy this file to .env and replace every placeholder locally.
# Never commit the real .env file.
PORT=5000
NODE_ENV=development
# Optional for additional browser clients. The bundled website is same-origin
# and does not need to be listed here.
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173

MONGO_URI=mongodb+srv://DATABASE_USER:DATABASE_PASSWORD@cluster.example.mongodb.net/chinky
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# Optional: override DNS resolvers for Mongo lookup issues.
# Example: DNS_SERVERS=8.8.8.8,1.1.1.1
DNS_SERVERS=

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

RAZORPAY_KEY=your_razorpay_key
RAZORPAY_SECRET=your_razorpay_secret

# ZEGOCLOUD: keep the server secret on Node only, never in Flutter.
ZEGO_APP_ID=your_numeric_app_id
ZEGO_SERVER_SECRET=your_zego_server_secret

# Required only when running multiple backend instances.
REDIS_URL=redis://localhost:6379

# Optional email transport used by OTP/reset mailers.
EMAIL=you@example.com
EMAIL_PASSWORD=app_password_or_smtp_password

# Optional SMS OTP provider (MSG91).
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# Optional: needed only for Firebase push notifications when ADC is unavailable.
# Keep the real service account secret on the backend only.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Google Play Billing server verification (service account with Android Publisher API access)
GOOGLE_PLAY_PACKAGE_NAME=com.chinky.social
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Apple App Store Server API (In-App Purchase key from App Store Connect)
APPLE_IAP_BUNDLE_ID=com.example.chinky
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional alternative billing checkout for eligible markets/programs.
# Keep false unless your Play/App distribution is approved/eligible for alternative billing.
ALTERNATIVE_BILLING_ENABLED=false
# Optional Razorpay payment-method configuration created in Razorpay Dashboard.
RAZORPAY_CHECKOUT_CONFIG_ID=
