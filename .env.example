# Copy this file to .env and replace every placeholder locally.
# Never commit the real .env file.
PORT=5000
NODE_ENV=development
# Optional for additional browser clients. The bundled website is same-origin
# and does not need to be listed here.
FRONTEND_ORIGINS=https://chinkyapp.com,https://www.chinkyapp.com,http://localhost:3000,http://localhost:5173

MONGO_URI=mongodb+srv://DATABASE_USER:DATABASE_PASSWORD@cluster.example.mongodb.net/chinky
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=30d

# Optional: override DNS resolvers for Mongo lookup issues.
# Example: DNS_SERVERS=8.8.8.8,1.1.1.1
DNS_SERVERS=

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CHINKY automatic sexual/adult-content moderation.
# Keep ON in production. The Cloudinary account must have both Rekognition
# moderation add-ons enabled in its Add-ons page.
CHINKY_CONTENT_MODERATION=on
CHINKY_PUBLIC_API_URL=https://chinkyapp.com
CHINKY_MODERATION_WEBHOOK_TOKEN=replace_with_a_long_random_webhook_secret
# Reject explicit nudity at 65%+ confidence and suggestive content at 82%+.
CHINKY_IMAGE_MODERATION=aws_rek:explicit_nudity:0.65:suggestive:0.82
CHINKY_VIDEO_MODERATION=aws_rek_video:explicit_nudity:0.65:suggestive:0.82

RAZORPAY_KEY=rzp_live_your_live_key_id
RAZORPAY_SECRET=your_live_key_secret

# ZEGOCLOUD: keep the server secret on Node only, never in Flutter.
ZEGO_APP_ID=your_numeric_app_id
ZEGO_SERVER_SECRET=your_zego_server_secret

# Required only when running multiple backend instances.
REDIS_URL=redis://localhost:6379

# Optional email transport used by OTP/reset mailers.
EMAIL=you@example.com
EMAIL_PASSWORD=app_password_or_smtp_password

# Optional SMS OTP provider (MSG91).
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_template_id

# Optional: needed only for Firebase push notifications when ADC is unavailable.
# Keep the real service account secret on the backend only.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Google Play Billing server verification (service account with Android Publisher API access)
GOOGLE_PLAY_PACKAGE_NAME=com.chinky.social
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Apple App Store Server API (In-App Purchase key from App Store Connect)
APPLE_IAP_BUNDLE_ID=com.example.chinky
APPLE_IAP_ISSUER_ID=
APPLE_IAP_KEY_ID=
APPLE_IAP_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Optional alternative billing checkout for eligible markets/programs.
# Keep false unless your Play/App distribution is approved/eligible for alternative billing.
ALTERNATIVE_BILLING_ENABLED=false
# Optional Razorpay payment-method configuration created in Razorpay Dashboard.
RAZORPAY_CHECKOUT_CONFIG_ID=

# Optional AI Help & Support. Keep this key on the backend only. Without it,
# CHINKY AI's built-in local rules and human escalation queue still work.
# auto = use the configured model when available, otherwise local_rules.
CHINKY_AI_PROVIDER=auto
CHINKY_AI_MODEL=gpt-5.6
OPENAI_API_KEY=

# Website Download App destination. Set a Play Store testing/public URL or direct APK URL.
CHINKY_APP_DOWNLOAD_URL=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
PURCHASE_USER_FEE_BPS=0
WITHDRAW_USER_FEE_BPS=500

# Safe payment recovery
PAYMENT_RECOVERY_ENABLED=true

# AdMob rewarded units for Daily Rewards
ADMOB_ANDROID_REWARDED_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
ADMOB_IOS_REWARDED_AD_UNIT_ID=ca-app-pub-xxxxxxxxxxxxxxxx/yyyyyyyyyy
